{
  "name": "traffic-controler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "fetch:osm": "node tools/fetchOsm.ts",
    "world:serve": "node --import ./tools/tsResolve.mjs server/index.ts",
    "world:ingest": "node --import ./tools/tsResolve.mjs tools/ingest.ts",
    "world:export": "node --import ./tools/tsResolve.mjs tools/export.ts",
    "world:bundle": "node --import ./tools/tsResolve.mjs tools/export.ts --out public/world",
    "deploy": "npm run world:bundle && VITE_WORLD_DB=/world npm run build && npx wrangler pages deploy dist --project-name traffic-sim --branch main"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.123.0"
  }
}
